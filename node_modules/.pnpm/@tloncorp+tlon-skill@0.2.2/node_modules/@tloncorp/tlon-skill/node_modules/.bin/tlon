#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

"$basedir/../../../../../../@tloncorp+tlon-skill-darwin-arm64@0.2.2/node_modules/@tloncorp/tlon-skill-darwin-arm64/tlon"   "$@"
exit $?
