From 6852465c9 Mon Sep 17 00:00:00 2001
From: Guilherme Ramos <guiramos@gmail.com>
Date: Wed, 4 Mar 2026 17:39:58 -0500
Subject: [PATCH] patch-15: Gateway Media Endpoint

Serve TTS audio and generated images via GET /media/{filename}.
Extends TTS temp file retention from 5 minutes to 7 days.

Search paths: /tmp/openclaw/tts-*/ (audio), ~/.openclaw/media/ (images),
/root/clawd/ (legacy fallback).
CORS headers + proper Content-Type for mp3/ogg/opus/wav/webm/png/jpg/gif/webp.
---
 src/gateway/server-http.ts | 74 ++++++++++++++++++++++++++++++++++++++
 src/tts/tts-core.ts        |  2 +-
 2 files changed, 75 insertions(+), 1 deletion(-)

diff --git a/src/gateway/server-http.ts b/src/gateway/server-http.ts
index ef0e56dd6..e7825278e 100644
--- a/src/gateway/server-http.ts
+++ b/src/gateway/server-http.ts
@@ -514,6 +514,80 @@ export function createGatewayHttpServer(opts: {
           name: "hooks",
           run: () => handleHooksRequest(req, res),
         },
+        {
+          name: "media",
+          run: async () => {
+            // Serve generated media files via GET /media/{filename}
+            if (req.method !== "GET" || !requestPath.startsWith("/media/")) {
+              return false;
+            }
+            // Allow web UIs on different origins (e.g. staging.hyperindiv.com) to fetch media
+            // generated by this gateway host.
+            res.setHeader("Access-Control-Allow-Origin", "*");
+            res.setHeader("Access-Control-Allow-Methods", "GET, OPTIONS");
+            res.setHeader("Access-Control-Allow-Headers", "Content-Type, Range");
+            res.setHeader("Vary", "Origin");
+            const filename = requestPath.slice("/media/".length);
+            // Security: only allow simple filenames (no path traversal)
+            if (filename && /^[\w.-]+$/.test(filename)) {
+              const fs = await import("node:fs");
+              const path = await import("node:path");
+              const os = await import("node:os");
+
+              const ext = path.extname(filename).toLowerCase();
+              const mimeMap: Record<string, string> = {
+                ".mp3": "audio/mpeg",
+                ".ogg": "audio/ogg",
+                ".opus": "audio/opus",
+                ".wav": "audio/wav",
+                ".webm": "audio/webm",
+                ".png": "image/png",
+                ".jpg": "image/jpeg",
+                ".jpeg": "image/jpeg",
+                ".gif": "image/gif",
+                ".webp": "image/webp",
+              };
+
+              const candidatePaths: string[] = [];
+
+              // 1) /tmp/openclaw/tts-*/<filename>
+              const ttsBaseDir = path.join(os.tmpdir(), "openclaw");
+              try {
+                const entries = fs.readdirSync(ttsBaseDir);
+                for (const entry of entries) {
+                  if (!entry.startsWith("tts-")) continue;
+                  candidatePaths.push(path.join(ttsBaseDir, entry, filename));
+                }
+              } catch {
+                // ignore
+              }
+
+              // 2) ~/.openclaw/media/<filename> (standard media directory)
+              candidatePaths.push(path.join(os.homedir(), ".openclaw", "media", filename));
+
+              // 3) /root/clawd/<filename> (legacy image output location)
+              candidatePaths.push(path.join("/root/clawd", filename));
+
+              for (const filePath of candidatePaths) {
+                try {
+                  if (!fs.existsSync(filePath)) continue;
+                  const stat = fs.statSync(filePath);
+                  if (!stat.isFile()) continue;
+                  res.setHeader("Content-Type", mimeMap[ext] ?? "application/octet-stream");
+                  res.setHeader("Content-Length", stat.size);
+                  res.setHeader("Cache-Control", "public, max-age=86400");
+                  fs.createReadStream(filePath).pipe(res);
+                  return true;
+                } catch {
+                  // continue with next candidate path
+                }
+              }
+            }
+            res.statusCode = 404;
+            res.end("Not Found");
+            return true;
+          },
+        },
         {
           name: "tools-invoke",
           run: () =>
diff --git a/src/tts/tts-core.ts b/src/tts/tts-core.ts
index c460793c3..8d05d2295 100644
--- a/src/tts/tts-core.ts
+++ b/src/tts/tts-core.ts
@@ -18,7 +18,7 @@ import type {
 } from "./tts.js";

 const DEFAULT_ELEVENLABS_BASE_URL = "https://api.elevenlabs.io";
-const TEMP_FILE_CLEANUP_DELAY_MS = 5 * 60 * 1000; // 5 minutes
+const TEMP_FILE_CLEANUP_DELAY_MS = 7 * 24 * 60 * 60 * 1000; // 7 days

 export function isValidVoiceId(voiceId: string): boolean {
   return /^[a-zA-Z0-9]{10,40}$/.test(voiceId);
--
