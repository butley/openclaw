+  // Shorten paths: ~/Projects/openclaw/src/web/foo.ts → foo.ts, ~/bob/TOOLS.md → TOOLS.md
+  text = text.replace(/~\/[A-Za-z0-9_./-]+/g, (match) => {
+    const parts = match.split("/");
+    if (parts.length <= 2) {
